---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Resources Coming Soon | Strategy Circle';
const description =
  'Strategy Circle resources are coming soon, including practical notes and advisory perspectives on finance, compliance, due diligence, and business structuring.';
---

<BaseLayout title={title} description={description}>
  <main class="resources-page">
    <section class="resources-hero">
      <div class="container resources-hero__inner">
        <p class="eyebrow">RESOURCES</p>
        <h1>Coming Soon</h1>
        <p>
          We’re building a practical resource hub for founders, finance teams, and growing businesses.
          Soon, this page will include notes, insights, and advisory perspectives on finance,
          compliance, due diligence, investment readiness, and business structuring.
        </p>
        <div class="resources-actions">
          <a href="/" class="button button--primary">Back to Home</a>
          <a href="https://calendly.com/swetharam250/30min" class="button button--secondary">
            Book a Strategy Consultation
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .resources-page {
    min-height: 70vh;
    background: var(--color-white);
  }

  .resources-hero {
    min-height: 72vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    background:
      radial-gradient(circle at 78% 32%, rgba(254, 198, 79, 0.18), transparent 26rem),
      linear-gradient(135deg, rgba(28, 51, 98, 0.96), rgba(16, 24, 32, 0.98)),
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: auto, auto, 32px 32px, 32px 32px;
    color: var(--color-white);
  }

  .resources-hero__inner {
    max-width: 820px;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-white);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }

  p {
    max-width: 720px;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .resources-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
  }

  .button--primary {
    background: var(--color-secondary);
    color: var(--color-white);
  }

  .button--secondary {
    border: 1px solid rgba(255, 255, 255, 0.34);
    color: var(--color-white);
  }

  .button--secondary:hover,
  .button--secondary:focus-visible {
    border-color: var(--color-secondary);
    background: rgba(243, 121, 32, 0.12);
  }

  @media (max-width: 640px) {
    .resources-hero {
      min-height: 68vh;
      padding-top: 7rem;
    }

    .resources-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>
