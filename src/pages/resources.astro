---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';

const title = 'Resources | Strategy Circle';
const description =
  'Practical notes and advisory perspectives from Strategy Circle on finance, compliance, due diligence, investment readiness, DPDP, and business structuring.';

const resources = (await getCollection('resources')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const types = ['All', ...Array.from(new Set(resources.map((entry) => entry.data.type)))];
const topics = Array.from(new Set(resources.map((entry) => entry.data.topic)));
---

<BaseLayout title={title} description={description}>
  <main class="resources-page">
    <section class="resources-library" aria-labelledby="resources-library-title">
      <div class="container">
        <div class="resources-toolbar">
          <div>
            <p class="eyebrow eyebrow--dark">LIBRARY</p>
            <h1 id="resources-library-title">Explore Resources</h1>
          </div>

          <div class="resources-count" aria-live="polite">
            <span data-resource-count>{resources.length}</span> resources
          </div>
        </div>

        <div class="filter-block" aria-label="Resource filters">
          <div class="filter-row" data-filter-group="type">
            {types.map((type, index) => (
              <button
                class={`filter-chip ${index === 0 ? 'is-active' : ''}`}
                type="button"
                data-filter-value={type.toLowerCase()}
              >
                {type}
              </button>
            ))}
          </div>

          <div class="topic-row" aria-label="Topics">
            {topics.map((topic) => (
              <span>{topic}</span>
            ))}
          </div>
        </div>

        {resources.length > 0 ? (
          <div class="resources-grid" data-resources-grid>
            {resources.map((entry) => (
              <ResourceCard
                title={entry.data.title}
                description={entry.data.description}
                href={`/resources/${entry.id}/`}
                type={entry.data.type}
                topic={entry.data.topic}
                date={entry.data.date}
                image={entry.data.image}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>Resources coming soon</h2>
            <p>
              We’re building a practical resource hub for founders, finance teams, and growing
              businesses.
            </p>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll('[data-filter-group="type"] .filter-chip');
  const cards = document.querySelectorAll('[data-resources-grid] .resource-card');
  const count = document.querySelector('[data-resource-count]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.getAttribute('data-filter-value');

      filterButtons.forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');

      let visible = 0;

      cards.forEach((card) => {
        const cardType = card.getAttribute('data-type');
        const shouldShow = selected === 'all' || cardType === selected;

        card.toggleAttribute('hidden', !shouldShow);

        if (shouldShow) {
          visible += 1;
        }
      });

      if (count) {
        count.textContent = String(visible);
      }
    });
  });
</script>

<style>
  .resources-page {
    background: #f8f7f4;
  }

  .resources-library {
    padding: 7rem 0 5.5rem;
  }

  .resources-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .resources-toolbar h1 {
    margin: 0;
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .resources-count {
    flex: 0 0 auto;
    margin-bottom: 0.25rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .filter-block {
    position: sticky;
    top: 4.75rem;
    z-index: 5;
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid rgba(28, 51, 98, 0.12);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 1.25rem 2.75rem rgba(16, 24, 32, 0.08);
    backdrop-filter: blur(14px);
  }

  .filter-row {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.1rem;
  }

  .filter-chip {
    appearance: none;
    border: 1px solid rgba(28, 51, 98, 0.16);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-primary);
    cursor: pointer;
    flex: 0 0 auto;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    padding: 0.7rem 1rem;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .filter-chip:hover,
  .filter-chip:focus-visible,
  .filter-chip.is-active {
    border-color: var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-white);
    transform: translateY(-1px);
  }

  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .topic-row span {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: rgba(28, 51, 98, 0.07);
    color: var(--color-primary);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .resources-grid [hidden] {
    display: none;
  }

  .empty-state {
    padding: 3rem;
    border: 1px solid rgba(28, 51, 98, 0.12);
    border-radius: 1.5rem;
    background: var(--color-white);
    text-align: center;
  }

  .empty-state h2 {
    margin: 0;
    color: var(--color-primary);
  }

  .empty-state p {
    max-width: 620px;
    margin: 0.8rem auto 0;
    color: var(--text-body);
  }

  @media (max-width: 980px) {
    .resources-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .resources-toolbar {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .resources-library {
      padding: 6.25rem 0 4rem;
    }

    .filter-block {
      top: 4.25rem;
      border-radius: 1rem;
      margin-left: -0.25rem;
      margin-right: -0.25rem;
    }

    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
