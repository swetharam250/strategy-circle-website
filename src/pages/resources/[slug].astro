---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');

  return resources.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-IN', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(entry.data.date);

const title = `${entry.data.title} | Strategy Circle`;
const description = entry.data.description;
---

<BaseLayout title={title} description={description}>
  <main class="article-page">
    <article>
      <header class="article-hero">
        <div class="container article-hero__inner">
          <a href="/resources/" class="back-link">← Resources</a>
          <p class="eyebrow">{entry.data.type} · {entry.data.topic}</p>
          <h1>{entry.data.title}</h1>
          <p class="article-description">{entry.data.description}</p>
          <div class="article-meta">
            <span>By {entry.data.author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
          </div>
        </div>
      </header>

      {entry.data.image && (
        <section class="article-image-section">
          <div class="container">
            <img src={entry.data.image} alt="" class="article-image" />
          </div>
        </section>
      )}

      <section class="article-content-section">
        <div class="container article-content-grid">
          <div class="article-body">
            <Content />

            {entry.data.sourceUrl && (
              <p class="source-note">
                Originally published on {entry.data.source ?? 'LinkedIn'}.
                <a href={entry.data.sourceUrl} target="_blank" rel="noreferrer">View original source</a>.
              </p>
            )}
          </div>

          <aside class="article-aside" aria-label="Consultation call to action">
            <div class="aside-card">
              <p class="eyebrow eyebrow--dark">STRATEGY CIRCLE</p>
              <h2>Need financial clarity for your next decision?</h2>
              <p>
                Speak with Strategy Circle about finance, compliance, due diligence,
                investment readiness, or business structuring.
              </p>
              <a href="https://calendly.com/swetharam250/30min" class="aside-cta">
                Book a Strategy Consultation
              </a>
            </div>
          </aside>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .article-page {
    background: #f8f7f4;
  }

  .article-hero {
    padding: 8.5rem 0 4rem;
    background:
      radial-gradient(circle at 82% 20%, rgba(254, 198, 79, 0.16), transparent 22rem),
      linear-gradient(135deg, rgba(28, 51, 98, 0.98), rgba(16, 24, 32, 0.98)),
      linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: auto, auto, 32px 32px, 32px 32px;
    color: var(--color-white);
  }

  .article-hero__inner {
    max-width: 920px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--color-secondary);
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow--dark {
    color: var(--color-secondary);
  }

  .article-hero h1 {
    max-width: 920px;
    margin: 0;
    color: var(--color-white);
    font-size: clamp(2.5rem, 5.5vw, 5.3rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  .article-description {
    max-width: 760px;
    margin: 1.15rem 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(1rem, 1.8vw, 1.22rem);
    line-height: 1.7;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .article-image-section {
    margin-top: -2.3rem;
  }

  .article-image {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: 1.5rem;
    box-shadow: 0 2rem 4.5rem rgba(16, 24, 32, 0.2);
  }

  .article-content-section {
    padding: 4rem 0 5.5rem;
  }

  .article-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(260px, 340px);
    gap: 3rem;
    align-items: start;
  }

  .article-body {
    padding: 2.25rem;
    border: 1px solid rgba(28, 51, 98, 0.1);
    border-radius: 1.5rem;
    background: var(--color-white);
    box-shadow: 0 1.5rem 3rem rgba(16, 24, 32, 0.06);
  }

  .article-body :global(p) {
    margin: 0 0 1.2rem;
    color: var(--text-body);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .article-body :global(ul) {
    margin: 0 0 1.35rem;
    padding-left: 1.2rem;
    color: var(--text-body);
  }

  .article-body :global(li) {
    margin-bottom: 0.55rem;
    line-height: 1.75;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin: 2rem 0 0.8rem;
    color: var(--color-primary);
    letter-spacing: -0.04em;
  }

  .source-note {
    margin-top: 2rem !important;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(28, 51, 98, 0.12);
    color: var(--text-muted) !important;
    font-size: 0.95rem !important;
  }

  .source-note a {
    color: var(--color-primary);
    font-weight: 800;
  }

  .article-aside {
    position: sticky;
    top: 6rem;
  }

  .aside-card {
    padding: 1.5rem;
    border-radius: 1.35rem;
    background:
      radial-gradient(circle at 82% 16%, rgba(254, 198, 79, 0.16), transparent 13rem),
      linear-gradient(145deg, var(--color-primary), var(--color-dark));
    color: var(--color-white);
    box-shadow: 0 1.5rem 3rem rgba(16, 24, 32, 0.16);
  }

  .aside-card h2 {
    margin: 0;
    color: var(--color-white);
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .aside-card p:not(.eyebrow) {
    margin: 0.85rem 0 1.25rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .aside-cta {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    background: var(--color-secondary);
    color: var(--color-white);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .aside-cta:hover,
  .aside-cta:focus-visible {
    transform: translateY(-1px);
  }

  @media (max-width: 920px) {
    .article-content-grid {
      grid-template-columns: 1fr;
    }

    .article-aside {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .article-hero {
      padding: 7.25rem 0 3.25rem;
    }

    .article-body {
      padding: 1.35rem;
    }

    .article-content-section {
      padding: 3rem 0 4rem;
    }
  }
</style>
