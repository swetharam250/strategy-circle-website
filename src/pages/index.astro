---
// -----------------------------------------------------------------------------
// index.astro — Homepage
// One-page landing site assembled from section components. All copy lives in
// the data files under src/data; this file only composes the layout.
// -----------------------------------------------------------------------------
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DifferenceGrid from '../components/DifferenceGrid.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AdvisorSection from '../components/AdvisorSection.astro';
import CTASection from '../components/CTASection.astro';

const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.strategycircle.co.in/#organization',
  name: 'Strategy Circle',
  url: 'https://www.strategycircle.co.in/',
  description:
    'Strategy Circle is a boutique financial advisory and compliance practice for startups, scale-ups, corporates, and investors.',
  founder: {
    '@type': 'Person',
    name: 'Swetha Ranganathan',
    jobTitle: 'Founder & Chartered Accountant',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@strategycircle.co.in',
    telephone: '+91-9585442481',
    contactType: 'customer service',
    areaServed: 'IN',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://www.linkedin.com/in/swetharanganathan2/',
  ],
};
---

<BaseLayout
  path="/"
  structuredData={organizationStructuredData}
>
  <Hero />
  <DifferenceGrid />
  <ServicesSection />
  <AdvisorSection />
  <CTASection />
</BaseLayout>
