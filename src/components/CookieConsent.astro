---
const GA_ID = 'G-Y6X5WWHFF3';
const CLARITY_ID = 'y4zacf3syu';
---

<div
  class="cookie-consent"
  data-cookie-consent
  data-ga-id={GA_ID}
  data-clarity-id={CLARITY_ID}
  hidden
>
  <div class="cookie-consent__inner">
    <div class="cookie-consent__copy">
      <p class="cookie-consent__eyebrow">COOKIES & PRIVACY</p>
      <p class="cookie-consent__text">
        We use optional analytics cookies to understand website usage and improve
        your experience. <a href="/privacy-notice/">Privacy Notice</a>.
      </p>
    </div>

    <div class="cookie-consent__actions">
      <button
        type="button"
        class="cookie-consent__button cookie-consent__button--secondary"
        data-cookie-reject
      >
        No thanks
      </button>

      <button
        type="button"
        class="cookie-consent__button cookie-consent__button--primary"
        data-cookie-accept
      >
        Allow analytics
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'strategy-circle-analytics-consent';
    const banner = document.querySelector('[data-cookie-consent]');

    if (!banner) return;

    const gaId = banner.dataset.gaId;
    const clarityId = banner.dataset.clarityId;

    const loadGoogleAnalytics = () => {
      if (!gaId || window.__strategyCircleGA4Loaded) return;
      window.__strategyCircleGA4Loaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };

      window.gtag('js', new Date());
      window.gtag('config', gaId);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
      document.head.appendChild(script);
    };

    const loadClarity = () => {
      if (!clarityId || window.__strategyCircleClarityLoaded) return;
      window.__strategyCircleClarityLoaded = true;

      window.clarity =
        window.clarity ||
        function () {
          (window.clarity.q = window.clarity.q || []).push(arguments);
        };

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.clarity.ms/tag/${encodeURIComponent(clarityId)}`;

      const firstScript = document.getElementsByTagName('script')[0];
      firstScript.parentNode.insertBefore(script, firstScript);
    };

    const enableAnalytics = () => {
      loadGoogleAnalytics();
      loadClarity();
    };

    const showBanner = () => {
      banner.hidden = false;
    };

    const hideBanner = () => {
      banner.hidden = true;
    };

    const saveChoice = (choice) => {
      try {
        localStorage.setItem(STORAGE_KEY, choice);
      } catch (_) {}
    };

    const getChoice = () => {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch (_) {
        return null;
      }
    };

    const applyChoice = (choice) => {
      if (choice === 'accepted') {
        enableAnalytics();
        hideBanner();
        return;
      }

      if (choice === 'rejected') {
        hideBanner();
        return;
      }

      showBanner();
    };

    banner
      .querySelector('[data-cookie-accept]')
      ?.addEventListener('click', () => {
        saveChoice('accepted');
        applyChoice('accepted');
      });

    banner
      .querySelector('[data-cookie-reject]')
      ?.addEventListener('click', () => {
        saveChoice('rejected');
        applyChoice('rejected');
      });

    document.addEventListener('strategy-circle:cookie-settings', () => {
      showBanner();
    });

    applyChoice(getChoice());
  })();
</script>

<style>
  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 9999;
    padding: var(--space-md);
    pointer-events: none;
  }

  .cookie-consent__inner {
    width: min(1080px, 100%);
    margin-inline: auto;
    padding: 1.15rem 1.25rem;
    background: var(--color-dark);
    color: var(--color-white);
    border: 1px solid var(--white-tint-08);
    border-radius: 1rem;
    box-shadow: 0 1.25rem 3.5rem rgba(16, 24, 32, 0.24);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    pointer-events: auto;
  }

  .cookie-consent__copy {
    max-width: 720px;
  }

  .cookie-consent__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-gold);
    font-size: 0.72rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .cookie-consent__text {
    margin: 0;
    color: var(--text-on-dark-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .cookie-consent__text a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .cookie-consent__button {
    min-height: 42px;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 800;
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .cookie-consent__button:hover,
  .cookie-consent__button:focus-visible {
    transform: translateY(-1px);
  }

  .cookie-consent__button--primary {
    border: 1px solid var(--color-secondary);
    background: var(--color-secondary);
    color: var(--color-dark);
  }

  .cookie-consent__button--secondary {
    border: 1px solid var(--white-tint-60);
    background: transparent;
    color: var(--color-white);
  }

  @media (max-width: 760px) {
    .cookie-consent {
      padding: var(--space-sm);
    }

    .cookie-consent__inner {
      align-items: stretch;
      flex-direction: column;
      gap: var(--space-md);
    }

    .cookie-consent__actions {
      width: 100%;
    }

    .cookie-consent__button {
      flex: 1;
    }
  }

  @media (max-width: 460px) {
    .cookie-consent__actions {
      flex-direction: column-reverse;
    }

    .cookie-consent__button {
      width: 100%;
    }
  }
</style>
